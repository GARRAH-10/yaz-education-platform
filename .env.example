# Public production URL used by canonical tags, hreflang, sitemap and structured data.
# Local: http://localhost:3000
# Vercel preview can use its generated URL; Production should use the final canonical domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console HTML-tag verification value (optional until launch)
GOOGLE_SITE_VERIFICATION=

# Google Gemini AI (server-side only)
# Create the key in Google AI Studio. Do not prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# Keep false by default. Set true only if you want current-web grounding through Gemini Google Search.
YAZ_AI_WEB_SEARCH=false

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only secret. Never expose this in browser code or commit .env.local.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Single-admin dashboard (server-side only)
ADMIN_DASHBOARD_EMAIL=admin@yazeducation.com
ADMIN_DASHBOARD_PASSWORD=change_this_to_a_long_unique_password
# Generate a long random value (32+ bytes). Never expose it to browser code.
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret

# Optional resilience. V24.6 tries at most one fallback model to keep replies responsive.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash

# V25 production note: configure every secret separately in Vercel Project Settings -> Environment Variables.
# Never paste .env.local into GitHub.
