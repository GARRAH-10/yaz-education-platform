# Public production URL used by canonical tags, hreflang, sitemap and structured data.
# Example after launch: https://www.yazeducation.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console HTML-tag verification value (optional until launch)
GOOGLE_SITE_VERIFICATION=

# OpenAI (optional until YAZ AI is enabled)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only secret. Never expose this in browser code or commit .env.local.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
